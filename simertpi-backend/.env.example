# Placeholders for local DEV only. Never commit a populated .env.
# Compose supplies its own internal DB_URL; change DB_URL for a native JVM/external DB.
DB_URL=jdbc:postgresql://postgres:5432/simertpi
DB_NAME=simertpi
DB_USERNAME=change-me
DB_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DEV_HTTP_PORT=8080
SIMERTPI_BACKEND_IMAGE=simertpi-backend:dev-local
SIMERTPI_EVIDENCE_STORAGE_BASE_PATH=/var/lib/simertpi/evidence
SIMERTPI_PAYMENT_PROVIDER=UNCONFIGURED
SIMERTPI_PAYMENT_SANDBOX_ENABLED=false
SIMERTPI_NOTIFICATION_PUSH_PROVIDER=UNCONFIGURED
SIMERTPI_NOTIFICATION_WHATSAPP_PROVIDER=UNCONFIGURED
SIMERTPI_NOTIFICATION_EMAIL_PROVIDER=UNCONFIGURED
SIMERTPI_NOTIFICATION_SANDBOX_ENABLED=false
